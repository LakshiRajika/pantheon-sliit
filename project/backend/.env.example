APP_NAME=Pantheon
APP_ENV=development
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://pantheon_user:pantheon_pass@localhost:5432/pantheon_db

JWT_SECRET_KEY=replace_this_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- LLM providers, tried strictly in this order; first one that succeeds wins ---
# 1) Groq - primary (fast inference, generous free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 2) Gemini - secondary fallback
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# 3) OpenRouter - tertiary fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
